# Copy to .env and never commit it. In production set NODE_ENV=production: the API then refuses
# to start until JWT_SECRET, DATABASE_URL, CORS_ORIGIN, APP_URL and SMTP_URL are set properly.
NODE_ENV=development
PORT=4000
# For a hosted database add ?sslmode=require.
# On the server (deploy/docker-compose.yml) it is postgres://edudesk:<POSTGRES_PASSWORD>@db:5432/edudesk
DATABASE_URL=postgres://USER@localhost:5432/edu_desk
# Server only: the password the compose database is created with (openssl rand -hex 24)
POSTGRES_PASSWORD=
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# The web app's exact origin (https://… in production)
CORS_ORIGIN=http://localhost:3000

# Where the web app runs; used for links in emails
APP_URL=http://localhost:3000
# Leave empty in development: emails are printed to the console instead
SMTP_URL=
MAIL_FROM=Blue <no-reply@example.com>
# Set to 1 when running behind one reverse proxy, so rate limits see the real client IP
TRUST_PROXY=
# Off for now: new accounts sign in straight away. Set to true to require the confirmation email.
REQUIRE_EMAIL_VERIFICATION=false
