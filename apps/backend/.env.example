PORT=4000
DATABASE_URL=postgres://USER@localhost:5432/edu_desk
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGIN=http://localhost:3000

# Where the web app runs; used for links in emails
APP_URL=http://localhost:3000
# Leave empty in development: emails are printed to the console instead
SMTP_URL=
MAIL_FROM=EduDesk <no-reply@example.com>
# Sign-ups allowed per IP per 24h. Schools often share one IP, so don't set it too low.
MAX_ACCOUNTS_PER_IP_PER_DAY=5
# Set to 1 when running behind one reverse proxy, so rate limits see the real client IP
TRUST_PROXY=
# Off for now: new accounts sign in straight away. Set to true to require the confirmation email.
REQUIRE_EMAIL_VERIFICATION=false
