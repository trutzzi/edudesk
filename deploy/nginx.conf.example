# Example reverse proxy: the web app on edudesk.example.com, the API on api.edudesk.example.com.
# Replace the domains, put it in /etc/nginx/sites-available/, then get certificates with
#   sudo certbot --nginx -d edudesk.example.com -d api.edudesk.example.com
# and set TRUST_PROXY=1 in shared/backend.env so rate limits see the real client IP.

server {
    listen 80;
    server_name edudesk.example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.edudesk.example.com;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
